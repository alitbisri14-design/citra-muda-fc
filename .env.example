# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP settings for OTP email delivery.
# Set these values in a local .env file when running the backend server locally.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-password"

# Supabase settings for attendance persistence from frontend.
# Create table (default): attendances with columns id (text), name (text), timestamp (timestamptz/text).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_ATTENDANCE_TABLE="attendances"
VITE_SUPABASE_SCHEMA="public"
VITE_API_BASE_URL="http://localhost:4000"

# Backend Supabase config (for server.ts)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ATTENDANCE_TABLE="attendances"
SUPABASE_TRANSACTIONS_TABLE="transactions"
SUPABASE_MATCHES_TABLE="matches"
SUPABASE_PLAYERS_TABLE="players"
